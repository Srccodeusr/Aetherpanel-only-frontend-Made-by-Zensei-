# PLATFORM ENVIRONMENT CONFIGURATION EXAMPLE
# Copy or set these environment variables in your server / container deployment environment.

# JWT Secret used for signing admin and user authentication tokens
JWT_SECRET="super_secret_jwt_key_change_me_in_production"

# Initial Super Admin credentials for bootstrap initialization
AETHER_ADMIN_EMAIL="admin@yourdomain.com"
AETHER_ADMIN_PASSWORD="change_me_secure_admin_password"

# Installation Isolation & Identity Keys
AETHER_INSTALLATION_ID="inst_default_01"
AETHER_INSTALLATION_SECRET="inst_secret_default_01"

# Public site URL for OAuth callbacks
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Anti-abuse / IP risk provider (Optional)
VPN_CHECK_API_KEY=""

# Discord OAuth2 App Credentials & Bot Integration (Optional)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/v1/auth/discord/callback"
DISCORD_BOT_TOKEN=""

# Firebase Web App Credentials for Google Sign-In (Optional)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Node environment mode
NODE_ENV="development"
